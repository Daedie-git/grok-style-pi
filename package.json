{
  "name": "grok-style-pi",
  "version": "1.0.0",
  "description": "Grok Build-inspired TUI chrome for Pi: GrokNight theme, cwd │ model │ N% ctx footer, focused composer frame, and diamond tool rows.",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Daedie-git/grok-style-pi.git"
  },
  "workspaces": [
    "packages/herdr-subagents",
    "packages/subagent-engine"
  ],
  "files": [
    "packages/herdr-subagents/extensions",
    "packages/herdr-subagents/src",
    "packages/herdr-subagents/package.json",
    "packages/herdr-subagents/README.md",
    "packages/herdr-subagents/LICENSE",
    "packages/subagent-engine/skills",
    "packages/subagent-engine/LICENSE",
    "packages/subagent-engine/README.md",
    "packages/subagent-engine/package.json",
    "packages/subagent-engine/src",
    "packages/subagent-engine/extensions",
    "extensions",
    "integrations",
    "src",
    "scripts",
    "themes",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "npm run typecheck && node --test test/*.test.ts packages/herdr-subagents/test/*.test.ts packages/subagent-engine/test/*.test.ts",
    "test:herdr": "npm test --workspace herdr-subagents",
    "bench:performance": "node scripts/benchmark-performance.ts",
    "setup:file-links": "node scripts/install-file-links.mjs",
    "test:bat": "GROK_BAT_INTEGRATION=1 node --test test/highlight-bat.test.ts",
    "typecheck:subagents": "tsc -p tsconfig.subagents.json",
    "test:current-pi": "node scripts/test-current-pi.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.subagents.json && npm run typecheck --workspace herdr-subagents && npm run typecheck --workspace subagent-engine",
    "test:engine": "npm test --workspace subagent-engine"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "themes": [
      "./themes"
    ],
    "skills": [
      "./packages/subagent-engine/skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/node": "22.20.4",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "mdast-util-from-markdown": "^2.0.3"
  }
}
