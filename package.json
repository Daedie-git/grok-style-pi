{
  "name": "grok-style-pi",
  "version": "1.0.0",
  "description": "Grok Build-inspired TUI chrome for Pi: GrokNight theme, cwd \u2502 model \u2502 N% ctx footer, focused composer frame, and diamond tool rows.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Daedie-git/grok-style-pi.git"
  },
  "files": [
    "extensions",
    "integrations",
    "src",
    "themes",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "npm run typecheck && node --test test/*.test.ts",
    "typecheck:subagents": "tsc -p tsconfig.subagents.json",
    "test:subagents": "node --test test/subagent-contract.test.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.subagents.json"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@tintinweb/pi-subagents": "0.19.0",
    "@types/node": "22.20.4",
    "typescript": "5.9.3"
  }
}
