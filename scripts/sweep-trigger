# shellcheck shell=bash
# Shared by the launcher and the Bash hook. The recent-sweep path uses only builtins.
schedule_sweep() {
  [[ ${HERDR_ENV:-} == 1 ]] || return 0
  local state="$HOME/.cache/claude-sidecar" now last=0 launcher=$1
  printf -v now '%(%s)T' -1
  if [[ -r $state/sweep.timestamp ]]; then read -r last <"$state/sweep.timestamp" || true; fi
  [[ $last =~ ^[0-9]+$ ]] || last=0
  (( now - last >= 60 )) || return 0
  mkdir -p "$state"
  (
    exec 6>"$state/sweep.lock"
    flock -n 6 || exit 0
    if [[ -r $state/sweep.timestamp ]]; then read -r last <"$state/sweep.timestamp" || true; fi
    [[ $last =~ ^[0-9]+$ ]] || last=0
    (( now - last >= 60 )) || exit 0
    printf '%s\n' "$now" >"$state/sweep.timestamp"
    # Keep the rate-limit lock until the sweep finishes.
    if command -v setsid >/dev/null 2>&1; then
      exec setsid "$launcher" sweep
    else
      exec "$launcher" sweep
    fi
  ) </dev/null >>"$state/sweep.log" 2>&1 &
}
